# App: name, port, environment, version, language, timezone.
APP_NAME=jungo
API_SERVER_PORT=8080
API_ENVIRONMENT=development
API_VERSION=v0.1.0
API_COMMIT=local
API_LANGUAGE=en
API_TIMEZONE=UTC

# Login: secret keys (set by `make app-init`; changing them logs everyone out), token TTLs, brute-force limits.
AUTH_TOKEN_HMAC_SECRET=
AUTH_TOKEN_ENCRYPTION_KEY=
AUTH_INTERNAL_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_SESSION_CACHE_TTL=3m
AUTH_REVOKED_RETENTION=168h
AUTH_PASSWORD_COST=12
AUTH_RECAPTCHA_ON_LOGIN=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_BLOCK_WINDOW=15m
AUTH_LOGIN_BLACKLIST_ATTEMPTS=8
AUTH_LOGIN_BLACKLIST_WINDOW=24h
AUTH_LOGIN_EMAIL_MAX_ATTEMPTS=10

# Optional container CPU/memory limits.
# APP_MEM_LIMIT=1024M
# APP_CPU_LIMIT=1.0
# APP_GOMEMLIMIT=900MiB

# Debug dashboard: add ?t_debug=<value> and header X-Internal-Secret. Empty = off.
TRACER_DEBUG_KEY=t_debug
TRACER_DEBUG_VALUE=

# PostgreSQL connection and pool.
DB_HOST=postgresql
DB_PORT=5432
DB_HOST_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jungo
DB_SSLMODE=disable
DB_MAX_CONNECTION=25
DB_MIN_CONNECTION=5
DB_QUERY_LOGGING=true

# CORS: which websites may call the API from a browser.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Device-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# Log level and file.
LOG_APP_LEVEL=debug
LOG_APP_FILENAME=storage/logs/app.log

# Rate limit per client: requests per second, plus burst.
LIMITER_RPS=10
LIMITER_BURST=30

# Max request body in bytes (2 MB). Upload routes set their own limit in code.
SECURITY_MAX_BODY_SIZE=2097152

# Proxy/load balancer IPs or CIDRs, comma-separated, to read the real client IP. Empty = no proxy.
SECURITY_TRUSTED_PROXIES=

# Redis cache: off by default; enable and run `make app-dev WITH=cache`.
CACHE_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Uploads: folder and public URL (empty = http://localhost:<port>/uploads).
STORAGE_BASE_DIR=./storage/uploads
STORAGE_BASE_URL=

# Telegram alerts: off while empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# reCAPTCHA: mock always passes outside production.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_MOCK=true
