# Basic app info: name, port, environment, version, language and timezone.
APP_NAME=jungo
API_SERVER_PORT=8080
API_ENVIRONMENT=development
API_VERSION=v0.1.0
API_COMMIT=local
API_LANGUAGE=en
API_TIMEZONE=UTC

# Login settings: secret keys (created by `make app-init`, changing them logs everyone out), token lifetimes and brute-force limits.
AUTH_TOKEN_HMAC_SECRET=
AUTH_TOKEN_ENCRYPTION_KEY=
AUTH_INTERNAL_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_SESSION_CACHE_TTL=3m
AUTH_REVOKED_RETENTION=168h
AUTH_PASSWORD_COST=12
AUTH_RECAPTCHA_ON_LOGIN=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_BLOCK_WINDOW=15m
AUTH_LOGIN_BLACKLIST_ATTEMPTS=8
AUTH_LOGIN_BLACKLIST_WINDOW=24h
AUTH_LOGIN_EMAIL_MAX_ATTEMPTS=10

# Optional limits on how much CPU and memory the app container may use.
# APP_MEM_LIMIT=1024M
# APP_CPU_LIMIT=1.0
# APP_GOMEMLIMIT=900MiB

# Add ?t_debug=<TRACER_DEBUG_VALUE> plus header X-Internal-Secret: <AUTH_INTERNAL_SECRET> to any URL to open the tracer debug dashboard.
TRACER_DEBUG_KEY=t_debug
TRACER_DEBUG_VALUE=

# PostgreSQL connection: where the database is, how to log in, and how many connections to keep open.
DB_HOST=postgresql
DB_PORT=5432
DB_HOST_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jungo
DB_SSLMODE=disable
DB_MAX_CONNECTION=25
DB_MIN_CONNECTION=5
DB_QUERY_LOGGING=true

# CORS: which websites may call this API from a browser, and with which methods and headers.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Device-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# Logging: how detailed the logs are and which file they are written to.
LOG_APP_LEVEL=debug
LOG_APP_FILENAME=storage/logs/app.log

# Rate limit: allowed requests per second per client, with a short burst allowance.
LIMITER_RPS=10
LIMITER_BURST=30

# Largest request body the API accepts, in bytes (2097152 = 2 MB).
SECURITY_MAX_BODY_SIZE=2097152

# Redis cache, off by default; turn on with CACHE_ENABLED=true and run `make app-dev WITH=cache`.
CACHE_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# File uploads: the folder they are saved in and the public URL they are served from.
STORAGE_BASE_DIR=./storage/uploads
STORAGE_BASE_URL=http://localhost:8080/uploads

# Telegram alerts, off while token and chat id are empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# reCAPTCHA bot check; with RECAPTCHA_MOCK=true it always passes outside production.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_MOCK=true
